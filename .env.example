# VERIDOC - Environment Configuration Example

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Backend Configuration
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=generate_a_strong_secret_key_here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veridoc

# Embedding Model / AI Config
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4-turbo-preview # or any other provider

# Vector DB (e.g. Pinecone, Qdrant, PGVector)
VECTOR_DB_URL=http://localhost:6333 # Local Qdrant example
VECTOR_DB_API_KEY=

# Storage (S3 / Local for documents)
STORAGE_PROVIDER=local
STORAGE_BUCKET=veridoc-documents
